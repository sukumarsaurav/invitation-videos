# Environment variables for Remotion Renderer
# Copy to .env and fill in your values

# PHP Webhook URL for receiving videos (boomerang)
CALLBACK_URL=https://invitationvideos.com/api/renders/receive-video.php

# PHP API for updating order status
STATUS_URL=https://invitationvideos.com/api/remotion/update-order.php

# Secret key for authenticating with PHP
RENDERER_SECRET_KEY=rmtn_render_secret_key_change_me

# Server port (Cloud Run sets this automatically)
PORT=8080

# Node environment
NODE_ENV=production
