{
    "name": "remotion-renderer",
    "version": "1.0.0",
    "description": "Cloud Run service for rendering Remotion videos - Boomerang Architecture",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "start": "node dist/index.js",
        "dev": "tsx watch src/index.ts",
        "build": "tsc && npm run bundle",
        "bundle": "remotion bundle remotion/index.ts --out-dir dist/bundle",
        "build:docker": "docker build -t remotion-renderer .",
        "deploy": "bash scripts/deploy.sh"
    },
    "dependencies": {
        "@remotion/bundler": "^4.0.0",
        "@remotion/renderer": "^4.0.0",
        "express": "^4.18.2",
        "form-data": "^4.0.0",
        "node-fetch": "^3.3.2",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "remotion": "^4.0.0",
        "zod": "^3.22.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^20.0.0",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "tsx": "^4.0.0",
        "typescript": "^5.0.0"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}