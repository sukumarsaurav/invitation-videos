    "format": "prettier --write 'templates/**/*.php' 'assets/**/*.css'"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^3.4.0"
  }
}
